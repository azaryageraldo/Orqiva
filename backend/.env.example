APP_NAME=Orqiva
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Default desktop/local installation. Without ORQIVA_DATA_DIR, the database
# lives at database/database.sqlite.
DB_CONNECTION=sqlite

# Server/VPS installation with MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=orqiva
# DB_USERNAME=orqiva
# DB_PASSWORD=

QUEUE_CONNECTION=database
QUEUE_WORKER_SLEEP=1

GEMINI_MODEL=
GEMINI_TIMEOUT=30

OPENAI_BASE_URL=https://api.openai.com/v1

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# API key provider AI dikelola dari halaman API Keys di aplikasi.
