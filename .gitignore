# Environment and credentials
.env
.env.*
!.env.example

# Dependencies and build output
/backend/vendor/
/backend/node_modules/
/backend/public/build/
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/

# Frontend build copied into Laravel for single-origin production serving
/backend/public/app.html
/backend/public/assets/
/backend/public/favicon.png
/backend/public/icons.svg
/backend/public/orqiva-mark.png
/backend/public/orqiva-widget.js

# Generated npm CLI payload
/packages/cli/app/
/packages/cli/build/
/packages/cli/node_modules/
/packages/*/*.tgz

# Laravel runtime files
/backend/storage/*.key
/backend/storage/logs/*.log
/backend/bootstrap/cache/*.php
/backend/storage/framework/cache/data/*
!/backend/storage/framework/cache/data/.gitkeep
/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitkeep
/backend/storage/framework/testing/*
/backend/.phpunit.result.cache

# Local tooling
.DS_Store
.idea/
.vscode/
.playwright-mcp/

# Laravel compiled views
/backend/storage/framework/views/*.php
